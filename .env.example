# Copy this file to .env and fill in your values

# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID(s) — comma separated if multiple admins
# Get your ID from @userinfobot
ADMIN_IDS=123456789,987654321

# PostgreSQL connection string
# Example: postgresql://postgres:postgres@localhost:5432/trusthold_escrow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trusthold_escrow

# Or use these individual PostgreSQL values instead of DATABASE_URL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trusthold_escrow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# Escrow fee percentage taken per deal
ESCROW_FEE_PERCENT=2.5
